#!/usr/bin/env bash

SCRIPT_DIR="$(cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")" && pwd)"
BONSAI_CONFIG="$HOME/.config/bonsai"
CLIENTS_DIR="$SCRIPT_DIR/clients"
PROJECTS_FILE="$BONSAI_CONFIG/projects.conf"
ACTIVE_FILE="$BONSAI_CONFIG/active"
DEMO_REPO="https://github.com/Agundur-KDE/DEMO.git"

# Dev mode: cms/ exists locally (git clone) — use compose.dev.yml with local build
# Standalone mode: cms/ is baked into the Docker image — use compose.yml (slim)
if [[ -d "$SCRIPT_DIR/cms" ]]; then
    COMPOSE_FILE="$SCRIPT_DIR/compose.dev.yml"
else
    COMPOSE_FILE="$SCRIPT_DIR/compose.yml"
fi

export UID
export GID
GID=$(id -g)

# Docker Compose liest .env automatisch ein, auch bei rohen `docker compose`-
# Aufrufen ohne diesen Wrapper — verhindert, dass UID/GID stillschweigend auf
# root fallen (passiert sonst z.B. beim Debuggen mit `docker compose exec`
# direkt) und dadurch root-owned Dateien entstehen, die spätere `./bonsai`-
# Läufe mit "Permission denied" blockieren.
printf 'UID=%s\nGID=%s\n' "$UID" "$GID" > "$SCRIPT_DIR/.env"

GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
BOLD='\033[1m'
RESET='\033[0m'

ok()   { echo -e "${GREEN}✓${RESET} $*"; }
info() { echo -e "${BOLD}▶${RESET} $*"; }
warn() { echo -e "${YELLOW}!${RESET} $*"; }
err()  { echo -e "${RED}✗${RESET} $*" >&2; }

# --- Config helpers ---

_config_init() {
    mkdir -p "$BONSAI_CONFIG" "$CLIENTS_DIR"
    [[ -f "$PROJECTS_FILE" ]] || touch "$PROJECTS_FILE"
}

_get_active() {
    [[ -f "$ACTIVE_FILE" ]] && cat "$ACTIVE_FILE" || echo ""
}

_set_active() {
    echo "$1" > "$ACTIVE_FILE"
}

_project_exists() {
    grep -q "^${1} " "$PROJECTS_FILE" 2>/dev/null
}

_get_git_url() {
    grep "^${1} " "$PROJECTS_FILE" | awk '{print $2}'
}

# --- Docker helpers ---

check_docker() {
    if ! command -v docker &>/dev/null; then
        err "Docker is not installed."
        err "Please install Docker Desktop: https://www.docker.com/products/docker-desktop"
        exit 1
    fi
    if ! docker info &>/dev/null; then
        err "Docker is not running. Please start Docker Desktop."
        exit 1
    fi
}

is_running() {
    docker compose -f "$COMPOSE_FILE" ps --status running 2>/dev/null | grep -q "cms"
}

_restart_if_running() {
    command -v docker &>/dev/null && docker info &>/dev/null 2>&1 || return
    if is_running; then
        info "Restarting Docker..."
        docker compose -f "$COMPOSE_FILE" restart > /dev/null 2>&1
        ok "Restarted."
    else
        info "BonsaiPress starting..."
        docker compose -f "$COMPOSE_FILE" up -d > /tmp/bonsai-start.log 2>&1 || {
            err "Error starting:"; cat /tmp/bonsai-start.log; exit 1
        }
        ok "Ready."
    fi
}

# --- Demo bootstrap ---

_ensure_demo() {
    [[ -e "$SCRIPT_DIR/current" ]] && return
    _config_init
    local demo_dir="$CLIENTS_DIR/DEMO"
    info "No project active — loading demo..."
    git clone "$DEMO_REPO" "$demo_dir" 2>/dev/null || { err "Demo clone failed (no internet?)."; exit 1; }
    _project_exists "DEMO" || echo "DEMO $DEMO_REPO" >> "$PROJECTS_FILE"
    ln -sfn "clients/DEMO" "$SCRIPT_DIR/current"
    _set_active "DEMO"
    ok "Demo ready."
}

# --- System commands ---

start() {
    check_docker
    _ensure_demo

    if is_running; then
        ok "BonsaiPress is already running."
        _show_urls
        return
    fi

    # sass_create_map aus der aktiven Client-Config lesen — steuert, ob der
    # Watcher für :8080 eine Sourcemap-CSS (main.dev.css) mitkompiliert.
    # bonsai static/deploy ignorieren das komplett, main.css bleibt immer Prod.
    SASS_CREATE_MAP=$(grep -oP '\$sass_create_map\s*=\s*\K(true|false)' \
        "$SCRIPT_DIR/current/config/ecms_config.php" 2>/dev/null)
    export SASS_CREATE_MAP="${SASS_CREATE_MAP:-false}"

    info "BonsaiPress starting..."
    docker compose -f "$COMPOSE_FILE" up -d > /tmp/bonsai-start.log 2>&1 || {
        err "Error starting:"
        cat /tmp/bonsai-start.log
        exit 1
    }

    ok "Ready."
    _show_urls
}

stop() {
    check_docker

    if ! is_running; then
        warn "BonsaiPress is not running."
        return
    fi

    info "Stopping BonsaiPress..."
    docker compose -f "$COMPOSE_FILE" down > /dev/null 2>&1
    ok "Stopped."
}

status() {
    check_docker

    local active
    active="$(_get_active)"

    if is_running; then
        ok "BonsaiPress is running."
        [[ -n "$active" ]] && echo -e "  Active project: ${BOLD}$active${RESET}"
        _show_urls
    else
        echo -e "  ${RED}●${RESET} BonsaiPress is not running  →  ${BOLD}bonsai start${RESET}"
        echo ""
    fi

    # Remote-Check für aktives Projekt
    if [[ -n "$active" && -d "$CLIENTS_DIR/$active/.git" ]]; then
        if timeout 5 git -C "$CLIENTS_DIR/$active" fetch --quiet 2>/dev/null; then
            local behind ahead
            behind=$(git -C "$CLIENTS_DIR/$active" rev-list "HEAD..@{u}" --count 2>/dev/null || echo "0")
            ahead=$(git -C "$CLIENTS_DIR/$active" rev-list "@{u}..HEAD" --count 2>/dev/null || echo "0")
            if [[ "$behind" -gt 0 ]]; then
                warn "${active} is ${behind} commit(s) behind origin — please pull before continuing"
            elif [[ "$ahead" -gt 0 ]]; then
                echo -e "  ${YELLOW}↑${RESET} ${active} is ${ahead} commit(s) ahead of origin — not pushed"
            else
                echo -e "  ${GREEN}✓${RESET} ${active} is up to date"
            fi
        else
            echo -e "  ${YELLOW}~${RESET} ${active}: remote unreachable"
        fi
        echo ""
    fi
}

_show_urls() {
    echo ""
    echo -e "  ${GREEN}●${RESET} Preview (dynamic)  →  ${BOLD}http://localhost:8080${RESET}"
    echo -e "  ${GREEN}●${RESET} Preview (static)   →  ${BOLD}http://localhost:8081${RESET}"
    echo ""
}

# --- bp passthrough ---

run_bp() {
    check_docker

    if ! is_running; then
        err "BonsaiPress is not running. First: bonsai start"
        exit 1
    fi

    docker compose -f "$COMPOSE_FILE" exec cms php /var/www/bin/bp "$@"
}

# --- Project management ---

list_cmd() {
    _config_init

    local active
    active="$(_get_active)"

    if [[ ! -s "$PROJECTS_FILE" ]]; then
        warn "No projects registered."
        echo "  Add a project: bonsai add <name> <git-url>"
        return
    fi

    echo ""
    while read -r name git_url; do
        [[ -z "$name" || "$name" == \#* ]] && continue

        local client_dir="$CLIENTS_DIR/$name"
        local marker color extra

        if [[ "$name" == "$active" ]]; then
            marker="●"; color="$GREEN"
        else
            marker="○"; color="$RESET"
        fi

        if [[ -d "$client_dir/.git" ]]; then
            local last
            last=$(git -C "$client_dir" log -1 --format="%cr" 2>/dev/null || echo "?")
            extra="local  (last commit: $last)"
        else
            extra="${YELLOW}→ will be cloned on switch${RESET}"
        fi

        echo -e "  ${color}${marker} ${BOLD}${name}${RESET}"
        echo    "    $git_url"
        echo -e "    $extra"
        echo ""
    done < "$PROJECTS_FILE"
}

switch_cmd() {
    local name="${1:-}"
    _config_init

    if [[ -z "$name" ]]; then
        err "Project name missing. Example: bonsai switch myclient"
        exit 1
    fi

    if ! _project_exists "$name"; then
        err "Project '$name' not registered."
        echo "  Available projects: bonsai list"
        echo "  Register it:        bonsai add $name <git-url>"
        exit 1
    fi

    local active
    active="$(_get_active)"

    if [[ "$name" == "$active" && -L "$SCRIPT_DIR/current" ]]; then
        ok "Project '$name' is already active."
        return
    fi

    # Uncommitted changes check
    if [[ -n "$active" && -d "$CLIENTS_DIR/$active/.git" ]]; then
        local changes
        changes=$(git -C "$CLIENTS_DIR/$active" status --porcelain 2>/dev/null)
        if [[ -n "$changes" ]]; then
            err "Project '$active' has uncommitted changes:"
            echo ""
            git -C "$CLIENTS_DIR/$active" status --short
            echo ""
            err "Please commit or stash first."
            exit 1
        fi
    fi

    local git_url client_dir
    git_url="$(_get_git_url "$name")"
    client_dir="$CLIENTS_DIR/$name"

    if [[ ! -d "$client_dir/.git" ]]; then
        # First time: clone from remote
        info "First time — cloning '$name'..."
        if ! git clone "$git_url" "$client_dir"; then
            err "Clone failed."
            exit 1
        fi
        git -C "$client_dir" submodule update --init --recursive --quiet
        ok "Cloned."
    else
        # Cached: try to fetch
        info "Checking remote..."
        if timeout 10 git -C "$client_dir" fetch --quiet 2>/dev/null; then
            local behind
            behind=$(git -C "$client_dir" rev-list "HEAD..@{u}" --count 2>/dev/null || echo "0")
            if [[ "$behind" -gt 0 ]]; then
                warn "$behind new commit(s) on remote."
                read -r -p "  Run git pull? [Y/n] " answer
                if [[ "${answer:-Y}" =~ ^[Yy]$ ]]; then
                    git -C "$client_dir" pull --quiet
                    git -C "$client_dir" submodule update --init --recursive --quiet
                    ok "Updated."
                fi
            else
                ok "Locally up to date."
                git -C "$client_dir" submodule update --init --recursive --quiet
            fi
        else
            local last
            last=$(git -C "$client_dir" log -1 --format="%cr" 2>/dev/null || echo "unknown")
            warn "Remote unreachable — using local cache."
            echo -e "  ℹ Last known state: $last"
            read -r -p "  Switch anyway? [Y/n] " answer
            if [[ ! "${answer:-Y}" =~ ^[Yy]$ ]]; then
                echo "Cancelled."
                exit 0
            fi
        fi
    fi

    # Update symlink and active marker
    info "Switching to '$name'..."

    # If current/ is a real directory (not yet a symlink), check for changes and remove
    if [[ -d "$SCRIPT_DIR/current" && ! -L "$SCRIPT_DIR/current" ]]; then
        local dirty
        dirty=$(git -C "$SCRIPT_DIR/current" status --porcelain 2>/dev/null)
        if [[ -n "$dirty" ]]; then
            err "current/ is not yet a symlink and has uncommitted changes."
            err "Please commit and push in current/ first, then switch again."
            exit 1
        fi
        rm -rf "$SCRIPT_DIR/current"
    fi

    ln -sfn "clients/$name" "$SCRIPT_DIR/current"
    _set_active "$name"

    # Bootstrap-Version aus Projekt auschecken
    local bs_version_file="$SCRIPT_DIR/current/config/bootstrap-version.txt"
    if [[ -f "$bs_version_file" ]]; then
        local bs_version
        bs_version=$(tr -d '"' < "$bs_version_file" | tr -d '[:space:]')
        if [[ -n "$bs_version" ]]; then
            info "Bootstrap: checking out $bs_version..."
            if git -C "$SCRIPT_DIR/cms/bootstrap" checkout "$bs_version" --quiet 2>/dev/null; then
                ok "Bootstrap $bs_version active."
            else
                warn "Bootstrap version '$bs_version' not found — staying on current version."
            fi
        fi
    fi

    _restart_if_running

    echo ""
    ok "Active project: ${BOLD}$name${RESET}"
    _show_urls
}

add_cmd() {
    local name="${1:-}" git_url="${2:-}"
    _config_init

    if [[ -z "$name" || -z "$git_url" ]]; then
        err "Usage: bonsai add <name> <git-url>"
        exit 1
    fi

    if _project_exists "$name"; then
        err "Project '$name' is already registered."
        exit 1
    fi

    echo "$name $git_url" >> "$PROJECTS_FILE"
    ok "Project '$name' registered."
    echo "  Switch with: bonsai switch $name"
}

remove_cmd() {
    local name="${1:-}"
    _config_init

    if [[ -z "$name" ]]; then
        err "Usage: bonsai remove <name>"
        exit 1
    fi

    if ! _project_exists "$name"; then
        err "Project '$name' not found."
        exit 1
    fi

    local active
    active="$(_get_active)"
    if [[ "$name" == "$active" ]]; then
        err "Cannot remove the active project. Switch to another one first."
        exit 1
    fi

    local tmpfile
    tmpfile=$(mktemp)
    grep -v "^${name} " "$PROJECTS_FILE" > "$tmpfile"
    mv "$tmpfile" "$PROJECTS_FILE"

    if [[ -d "$CLIENTS_DIR/$name" ]]; then
        read -r -p "  Also delete local cache? [y/N] " answer
        if [[ "${answer:-N}" =~ ^[Yy]$ ]]; then
            rm -rf "${CLIENTS_DIR:?}/$name"
            ok "Cache deleted."
        fi
    fi

    ok "Project '$name' removed."
}

# --- New project ---

new_cmd() {
    local name="${1:-}" remote_url="${2:-}"
    _config_init

    [[ -z "$name" ]] && { err "Usage: bonsai new <name> [<remote-url>]"; exit 1; }
    _project_exists "$name" && { err "Project '$name' is already registered."; exit 1; }

    local client_dir="$CLIENTS_DIR/$name"
    [[ -d "$client_dir" ]] && { err "Directory '$client_dir' already exists."; exit 1; }

    # Template URL aus ~/.config/bonsai/config (BONSAI_TEMPLATE=...)
    local config_file="$BONSAI_CONFIG/config"
    local template_url=""
    [[ -f "$config_file" ]] && template_url=$(grep "^BONSAI_TEMPLATE=" "$config_file" | cut -d= -f2-)
    if [[ -z "$template_url" ]]; then
        err "No template configured. Please add this to '$config_file':"
        echo "  BONSAI_TEMPLATE=git@github.com:user/bonsai-template.git"
        exit 1
    fi

    # Template klonen, Git-History entfernen
    info "Cloning template..."
    git clone "$template_url" "$client_dir" || { err "Clone failed."; exit 1; }
    git -C "$client_dir" submodule update --init --recursive --quiet
    rm -rf "$client_dir/.git"
    git -C "$client_dir" init
    ok "Git initialized."

    # Remote-URL (Argument oder interaktiv)
    if [[ -z "$remote_url" ]]; then
        read -r -p "  Remote URL for '$name' (Enter = no remote): " remote_url
    fi
    if [[ -n "$remote_url" ]]; then
        git -C "$client_dir" remote add origin "$remote_url"
        ok "Remote: $remote_url"
    fi

    # Initialer Commit
    git -C "$client_dir" add -A
    git -C "$client_dir" commit -m "Initial commit"
    ok "Initial commit created."

    # In projects.conf registrieren
    echo "$name ${remote_url:--}" >> "$PROJECTS_FILE"
    ok "Project '$name' registered."

    # Automatisch wechseln (außer aktives Projekt hat uncommittete Änderungen)
    local active do_switch=1
    active="$(_get_active)"
    if [[ -n "$active" && -d "$CLIENTS_DIR/$active/.git" ]]; then
        local changes
        changes=$(git -C "$CLIENTS_DIR/$active" status --porcelain 2>/dev/null)
        if [[ -n "$changes" ]]; then
            warn "Active project '$active' has uncommitted changes — not switching automatically."
            echo "  Switch with: bonsai switch $name"
            do_switch=0
        fi
    fi

    if [[ "$do_switch" -eq 1 ]]; then
        ln -sfn "clients/$name" "$SCRIPT_DIR/current"
        _set_active "$name"
        _restart_if_running
        echo ""
        ok "Active project: ${BOLD}$name${RESET}"
        _show_urls
    fi

    # Checklist für neue Nutzer
    echo ""
    info "Next steps:"
    echo -e "  1. Fill in ${BOLD}current/config/bonsai_config.php${RESET} (FTP, domain)"
    echo -e "     ${YELLOW}⚠  Contains passwords — already in .gitignore, never commit!${RESET}"
    echo -e "  2. ${BOLD}bonsai static${RESET}   — generate static HTML"
    echo -e "  3. ${BOLD}bonsai deploy${RESET}   — deploy (creates web/ + include/ on the server automatically)"
    echo -e "  4. CI/CD optional:  ${BOLD}https://github.com/Agundur-KDE/ftp-hash-deploy-action${RESET}"
    echo -e "     Replaces 'bonsai deploy' in GitHub Actions"
    echo ""

    # Push anbieten
    if [[ -n "$remote_url" ]]; then
        read -r -p "  Push now? [Y/n] " answer
        if [[ "${answer:-Y}" =~ ^[Yy]$ ]]; then
            git -C "$client_dir" push -u origin HEAD || warn "Push failed."
        fi
    fi
}

# --- Install ---

install_cmd() {
    local target="" self
    self="$(realpath "${BASH_SOURCE[0]}")"

    for dir in "$HOME/.local/bin" "$HOME/bin"; do
        if [[ ":$PATH:" == *":$dir:"* ]]; then
            target="$dir/bonsai"
            break
        fi
    done

    if [[ -z "$target" ]]; then
        err "No suitable directory found in PATH (~/.local/bin or ~/bin)."
        err "Create the symlink manually: ln -s $self ~/.local/bin/bonsai"
        exit 1
    fi

    if [[ -L "$target" ]]; then
        ln -sf "$self" "$target"
        ok "Updated: $target"
        return
    fi

    ln -s "$self" "$target"
    ok "Installed: $target"
    ok "You can now type 'bonsai' anywhere."
}

# --- Help ---

help_cmd() {
    echo ""
    echo -e "  ${BOLD}BonsaiPress${RESET}"
    echo ""
    echo "  bonsai start                   Start the system"
    echo "  bonsai stop                    Stop the system"
    echo "  bonsai restart                 Restart"
    echo "  bonsai status                  Show status and URLs"
    echo ""
    echo "  bonsai list                    Show all projects"
    echo "  bonsai new <name> [<url>]      Create a new project from the template"
    echo "  bonsai switch <name>           Switch to a project"
    echo "  bonsai add <name> <git-url>    Register a project"
    echo "  bonsai remove <name>           Remove a project"
    echo ""
    echo "  bonsai static                  Build the static export"
    echo "  bonsai deploy                  Deploy to the server"
    echo "  bonsai deploy -d               Preview deploy (dry-run)"
    echo ""
    echo "  bonsai version                 Show version"
    echo "  bonsai update                  Update Docker images"
    echo "  bonsai install                 One-time: make 'bonsai' available everywhere"
    echo ""
}

# --- Version ---

version_cmd() {
    if [[ -d "$SCRIPT_DIR/.git" ]]; then
        git -C "$SCRIPT_DIR" describe --tags 2>/dev/null || cat "$SCRIPT_DIR/VERSION" 2>/dev/null || echo "unknown"
    else
        cat "$SCRIPT_DIR/VERSION" 2>/dev/null || echo "unknown"
    fi
}

# --- Update ---

update_cmd() {
    check_docker
    info "Updating Docker images..."
    docker compose -f "$COMPOSE_FILE" pull
    ok "Images up to date."
    if is_running; then
        info "Restarting containers..."
        docker compose -f "$COMPOSE_FILE" up -d
        ok "Done."
    fi
}

# --- Router ---

case "${1:-help}" in
    start)          start ;;
    stop)           stop ;;
    restart)        stop; start ;;
    version|--version|-v) version_cmd ;;
    update)         update_cmd ;;
    status)         status ;;
    list)           list_cmd ;;
    new)            shift; new_cmd "$@" ;;
    switch)         shift; switch_cmd "$@" ;;
    add)            shift; add_cmd "$@" ;;
    remove)         shift; remove_cmd "$@" ;;
    static)
        shift
        # prod-CSS vor dem Export: kein source-map, komprimiert.
        # In main.css.new bauen und nur übernehmen wenn sich der Inhalt
        # wirklich geändert hat — sonst bumpt main.css bei jedem Lauf seine
        # mtime, und AssetVersioner (?v=<mtime>) cache-bustet grundlos auf
        # jeder Seite, obwohl sich am CSS gar nichts geändert hat.
        docker compose -f "$COMPOSE_FILE" exec watcher sass \
            --no-source-map --style=compressed \
            --silence-deprecation=mixed-decls \
            --silence-deprecation=abs-percent \
            --load-path=cms/bootstrap/scss \
            --load-path=current/config/sass \
            current/config/sass/main.scss:current/static/_resources/css/main.css.new
        if [ -f current/static/_resources/css/main.css.new ]; then
            if ! cmp -s current/static/_resources/css/main.css.new current/static/_resources/css/main.css 2>/dev/null; then
                mv current/static/_resources/css/main.css.new current/static/_resources/css/main.css
            else
                rm current/static/_resources/css/main.css.new
            fi
        fi
        # main.dev.css (Sourcemap-Variante für :8080, sass_create_map) darf nie
        # exportiert/deployt werden — hart löschen, unabhängig vom Watcher-Zustand.
        # main.css.watcher.new: Staging-Datei des Watchers (eigener Name, damit
        # sie nie mit main.css.new hier kollidiert) — falls der Watcher-Prozess
        # mitten im Schreiben unterbrochen wurde, nie exportieren.
        rm -f current/static/_resources/css/main.dev.css \
              current/static/_resources/css/main.dev.css.new \
              current/static/_resources/css/main.dev.css.map \
              current/static/_resources/css/main.dev.css.new.map \
              current/static/_resources/css/main.css.watcher.new
        run_bp static "$@"
        ;;
    deploy)
        shift
        # main.css.new: Reste eines abgebrochenen static-Laufs. main.dev.css +
        # main.css.watcher.new: dürfen nie auf den Server, siehe static)-Block.
        rm -f current/static/_resources/css/main.css.new \
              current/static/_resources/css/main.css.watcher.new \
              current/static/_resources/css/main.dev.css \
              current/static/_resources/css/main.dev.css.new \
              current/static/_resources/css/main.dev.css.map \
              current/static/_resources/css/main.dev.css.new.map
        # Nur Clients mit eigenen Composer-Dependencies (current/include/composer.json)
        # betroffen — cms/ selbst hat keine. Bricht den Deploy ab, wenn composer audit
        # eine bekannte Sicherheitslücke in einer Dependency findet.
        if [ -f current/include/composer.json ]; then
            info "Composer security audit (current/include)..."
            if ! (cd current/include && composer audit --no-interaction); then
                err "composer audit found security vulnerabilities — deploy aborted."
                exit 1
            fi
            ok "No known vulnerabilities."
        fi
        run_bp deploy "$@"
        ;;
    install)        install_cmd ;;
    help|--help|-h) help_cmd ;;
    *)
        err "Unknown command: ${1}"
        echo "  Help: bonsai help"
        exit 1
        ;;
esac
